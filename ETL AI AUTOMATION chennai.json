    {
      "parameters": {
        "promptType": "define",
        "text": "=Clean this student enrollment row and return ONLY a JSON object.\n\nRow data: {{ JSON.stringify($json) }}\n\nKeep exactly these keys: Student_ID, Name, Email, Phone, Course, Fee_Paid, City, Enrolled_Date.\n\nRules:\n- Student_ID: keep unchanged\n- Name: Title Case (Manoj K)\n- Email: lowercase; if it is not a complete address like name@domain.com, set INVALID_EMAIL. Do not fix or guess emails.\n- Phone: digits only; if less than 10 digits or empty set MISSING\n- Course: only Python, Machine Learning or Data Science (ml/ML = Machine Learning)\n- Fee_Paid: yes/YES/Yes = true, no/NO/No = false (JSON boolean)\n- City: Title Case, empty = UNKNOWN\n- Enrolled_Date: input is DD-MM-YYYY, convert to YYYY-MM-DD\n\nReturn ONLY raw JSON. No explanation. No markdown.",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        176,
        288
      ],
      "id": "bad0523c-e546-489f-9d06-76624b21b71a",
      "name": "Basic LLM Chain"
    },
