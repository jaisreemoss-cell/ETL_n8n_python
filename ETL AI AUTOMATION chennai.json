      ],
      "id": "b5eadf7c-a166-401a-aeda-cc96c7bbfa74",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "PLP9metMhmALyTYU",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parses the LLM's JSON and normalises fields. Runs once per loop batch.\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nconst toStr = (v) => (v === null || v === undefined ? \"\" : String(v)).trim();\n\nreturn $input.all().map((item) => {\n  let data = item.json;\n  try {\n    for (const key of [\"output\", \"text\", \"result\"]) {\n      if (typeof data[key] === \"string\") { data = data[key]; break; }\n    }\n    if (typeof data === \"string\") {\n      data = JSON.parse(data.replace(/```json|```/g, \"\").trim());\n    }\n\n    data.Student_ID = toStr(data.Student_ID);\n    data.Name = toStr(data.Name);\n    data.Email = toStr(data.Email).toLowerCase();\n    const phone = toStr(data.Phone).replace(/\\D/g, \"\");\n    data.Phone = phone.length >= 10 ? phone : \"MISSING\";\n    data.Course = toStr(data.Course);\n    data.City = toStr(data.City) || \"UNKNOWN\";\n    data.Fee_Paid = data.Fee_Paid === true || /^(yes|true)$/i.test(toStr(data.Fee_Paid));\n    data.Enrolled_Date = toStr(data.Enrolled_Date);\n    data.Email_Valid = emailRegex.test(data.Email);\n\n    return { json: data };\n  } catch (error) {\n    return { json: { error: \"Invalid JSON from AI\", raw: JSON.stringify(item.json) } };\n  }\n});"
      },
